<div class="col mb-4">
  <a href="{{ project.url | relative_url }}" class="project-card-link">
    <div class="project-card">
      <div class="project-card-img">
        {% if project.img %}
          {% include figure.liquid loading="eager" path=project.img alt=project.title sizes="(min-width: 768px) 33vw, 95vw" %}
        {% else %}
          <div class="project-card-placeholder"><i class="fas fa-microchip" aria-hidden="true"></i></div>
        {% endif %}
      </div>
      <div class="project-card-body">
        <h2 class="project-card-title">{{ project.title }}</h2>
        <p class="project-card-desc">{{ project.description }}</p>
        <span class="project-card-more">View project <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
      </div>
    </div>
  </a>
</div>
